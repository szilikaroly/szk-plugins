#!/usr/bin/env bash
# composer — literature intake with the 5D admission gate, from any shell.
#
#   composer harvest  --query '...' --query-name endo --raw --retmax 500 --xml-fallback
#   composer validate --records refs.csv --out refs-validacio.csv --no-fulltext-gate
#   composer protocol init --project endo-diet --title "..."
#   composer prisma   --project endo-diet status
#   composer selftest
set -euo pipefail
# The launcher is reached through a symlink in ~/.local/bin, so BASH_SOURCE is
# that symlink, not this file. Walk the link chain (macOS has no `readlink -f`)
# to find the real script directory — otherwise the shared resolver is looked up
# next to the symlink and nothing runs from outside the repo.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
_dir="$(cd -P "$(dirname "$_self")" && pwd)"
source "$_dir/_resolve.sh"

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  harvest|collect)  szk_run composer scripts/collect      "$@" ;;
  validate|5d)      szk_run composer scripts/validate5d.py "$@" ;;
  protocol|prospero) szk_run composer scripts/prospero.py  "$@" ;;
  prisma|flow)      szk_run composer scripts/prisma        "$@" ;;
  selftest)         szk_run composer scripts/selftest.py   "$@" ;;
  ""|-h|--help|help)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$_self"
    exit 0 ;;
  *)
    echo "composer: unknown subcommand '$cmd'" >&2
    echo "  harvest | validate | protocol | prisma | selftest" >&2
    exit 2 ;;
esac
