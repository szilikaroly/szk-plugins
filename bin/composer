#!/usr/bin/env bash
# composer — literature intake with the 5D admission gate, from any shell.
#
#   composer harvest  --query '...' --query-name endo --raw --retmax 500 --xml-fallback
#   composer lookup   --sources openalex --query '...' --query-name endo
#   composer scholar  --query '"..." "..."' --query-name endo --retmax 100 --years 10
#   composer validate --records refs.csv --out refs-validacio.csv --no-fulltext-gate
#   composer protocol init --project endo-diet --title "..."
#   composer prisma   --project endo-diet status
#   composer selftest
set -euo pipefail
# The launcher is reached through a symlink in ~/.local/bin, so BASH_SOURCE is
# that symlink, not this file. Walk the link chain (macOS has no `readlink -f`)
# to find the real script directory — otherwise the shared resolver is looked up
# next to the symlink and nothing runs from outside the repo.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
_dir="$(cd -P "$(dirname "$_self")" && pwd)"
source "$_dir/_resolve.sh"

# composer ships its own interpreter picker (scripts/run): the scripts' shebangs
# name the Mac Anaconda, and a bare `python3` is the wrong interpreter on the Mac
# and the Microsoft Store stub on Windows. With SZK_PYTHON set, or on an install
# older than 1.3.1 that has no `run`, the shared runner is used as before.
crun() {
  local r
  if [[ -n "${SZK_PYTHON:-}" ]] || ! r="$(szk_resolve composer scripts/run)"; then
    szk_run composer "scripts/$1" "${@:2}"
  fi
  exec bash "$r" "$@"
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  harvest|collect)  crun collect       "$@" ;;
  scholar|gs)       crun scholar       "$@" ;;
  lookup)           crun lookup        "$@" ;;
  validate|5d)      crun validate5d.py "$@" ;;
  protocol|prospero) crun prospero.py  "$@" ;;
  prisma|flow)      crun prisma        "$@" ;;
  selftest)         crun selftest.py   "$@" ;;
  ""|-h|--help|help)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$_self"
    exit 0 ;;
  *)
    echo "composer: unknown subcommand '$cmd'" >&2
    echo "  harvest | scholar | lookup | validate | protocol | prisma | selftest" >&2
    exit 2 ;;
esac
